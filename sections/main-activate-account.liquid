<section class="page-width section-pad account-form">
  <h1 class="display-lg"><span class="chrome-text">{{ 'customer.activate' | t }}</span></h1>
  {%- form 'activate_customer_password' -%}
    {%- if form.errors -%}<p class="form-msg form-msg--err mono">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="field-wrap"><span class="field-label mono">{{ 'customer.password' | t }}</span><input class="field" type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label class="field-wrap"><span class="field-label mono">{{ 'customer.password_confirm' | t }}</span><input class="field" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <button class="chrome-btn chrome-btn--block"><span>{{ 'customer.activate' | t }}</span></button>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Activate account" }
{% endschema %}
