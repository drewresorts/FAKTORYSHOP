<section class="page-width section-pad account-form">
  <h1 class="display-lg"><span class="chrome-text">{{ 'customer.create' | t }}</span></h1>
  {%- form 'create_customer' -%}
    {%- if form.errors -%}<p class="form-msg form-msg--err mono">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="field-wrap"><span class="field-label mono">{{ 'customer.first_name' | t }}</span><input class="field" type="text" name="customer[first_name]" autocomplete="given-name"></label>
    <label class="field-wrap"><span class="field-label mono">{{ 'customer.last_name' | t }}</span><input class="field" type="text" name="customer[last_name]" autocomplete="family-name"></label>
    <label class="field-wrap"><span class="field-label mono">{{ 'customer.email' | t }}</span><input class="field" type="email" name="customer[email]" autocomplete="email" required></label>
    <label class="field-wrap"><span class="field-label mono">{{ 'customer.password' | t }}</span><input class="field" type="password" name="customer[password]" autocomplete="new-password" required></label>
    <button class="chrome-btn chrome-btn--block"><span>{{ 'customer.create' | t }}</span></button>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Register" }
{% endschema %}
