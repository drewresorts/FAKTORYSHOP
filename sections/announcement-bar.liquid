{%- if section.blocks.size > 0 -%}
  <div class="announcement" style="--speed: {{ section.settings.speed }}s">
    <div class="marquee" data-marquee>
      <div class="marquee__track">
        {%- for i in (1..4) -%}
          <div class="marquee__group"{% if i > 1 %} aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              <span class="marquee__item mono" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
                {%- else -%}
                  {{ block.settings.text }}
                {%- endif -%}
              </span>
              <span class="marquee__sep" aria-hidden="true">✦</span>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement ticker",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "range", "id": "speed", "min": 10, "max": 80, "step": 5, "unit": "s", "label": "Loop duration", "default": 35 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "NEW DROP OUT NOW" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement ticker",
      "blocks": [
        { "type": "message", "settings": { "text": "NEW DROP OUT NOW" } },
        { "type": "message", "settings": { "text": "STUDIO SESSIONS BOOKING" } }
      ]
    }
  ]
}
{% endschema %}
