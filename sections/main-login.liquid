<section class="page-width section-pad account-form">
  <h1 class="display-lg"><span class="chrome-text">{{ 'customer.login' | t }}</span></h1>
  <div id="RecoverForm" class="account-form__recover" hidden>
    {%- form 'recover_customer_password' -%}
      {%- if form.posted_successfully? -%}<p class="form-msg form-msg--ok mono">{{ 'customer.recover_success' | t }}</p>{%- endif -%}
      <label class="field-wrap"><span class="field-label mono">{{ 'customer.email' | t }}</span><input class="field" type="email" name="email" autocomplete="email" required></label>
      <button class="chrome-btn"><span>{{ 'customer.reset' | t }}</span></button>
      <a href="#login" class="link-underline mono" data-toggle-recover>{{ 'general.cancel' | t }}</a>
    {%- endform -%}
  </div>
  <div id="LoginForm">
    {%- form 'customer_login' -%}
      {%- if form.errors -%}<p class="form-msg form-msg--err mono">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="field-wrap"><span class="field-label mono">{{ 'customer.email' | t }}</span><input class="field" type="email" name="customer[email]" autocomplete="email" required></label>
      <label class="field-wrap"><span class="field-label mono">{{ 'customer.password' | t }}</span><input class="field" type="password" name="customer[password]" autocomplete="current-password" required></label>
      <button class="chrome-btn chrome-btn--block"><span>{{ 'customer.sign_in' | t }}</span></button>
    {%- endform -%}
    <p class="mono account-form__links">
      <a href="#recover" class="link-underline" data-toggle-recover>{{ 'customer.forgot' | t }}</a>
      <a href="{{ routes.account_register_url }}" class="link-underline">{{ 'customer.create' | t }}</a>
    </p>
  </div>
</section>
{% schema %}
{ "name": "Login" }
{% endschema %}
