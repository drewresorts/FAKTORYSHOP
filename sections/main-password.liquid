<section class="password">
  <faktory-scene class="password__scene" data-shape="{{ section.settings.shape }}" data-iridescence="0.5" data-roughness="0.05" data-tint="#ffffff" data-spin="1" data-particles="true"></faktory-scene>
  <div class="password__body">
    <p class="eyebrow mono"><i class="live-dot"></i>{{ section.settings.eyebrow }}</p>
    <h1 class="display-xxl"><span class="chrome-text">{{ shop.name }}</span></h1>
    {%- if shop.password_message != blank -%}<p class="mono">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      <div class="newsletter-form__row">
        <label for="PwEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
        <input id="PwEmail" class="field" type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}">
        <button type="submit" class="chrome-btn"><span>{{ 'newsletter.button' | t }}</span></button>
      </div>
      {%- if form.posted_successfully? -%}<p class="form-msg form-msg--ok mono">{{ 'newsletter.success' | t }}</p>{%- endif -%}
    {%- endform -%}
    <details class="password__login mono">
      <summary>{{ 'general.password_enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        <div class="newsletter-form__row">
          <label for="Password" class="visually-hidden">Password</label>
          <input id="Password" class="field" type="password" name="password" autocomplete="current-password" placeholder="PASSWORD">
          <button type="submit" class="ghost-btn"><span>{{ 'general.enter' | t }}</span></button>
        </div>
        {%- if form.errors -%}<p class="form-msg form-msg--err">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "COMING SOON" },
    { "type": "select", "id": "shape", "label": "3D shape", "options": [{ "value": "blob", "label": "Blob" }, { "value": "logo", "label": "F monogram" }, { "value": "knot", "label": "Knot" }, { "value": "rings", "label": "Rings" }], "default": "logo" }
  ]
}
{% endschema %}
