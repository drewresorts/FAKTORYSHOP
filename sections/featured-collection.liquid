{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
-%}
<section class="merch section-pad">
  <div class="page-width section-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow mono">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="display-lg reveal"><span class="chrome-text">{{ section.settings.heading }}</span></h2>
    </div>
    {%- if collection != blank -%}
      <a class="link-underline mono" href="{{ collection.url }}">{{ 'sections.featured_collection.view_all' | t }} ({{ collection.products_count }}) {% render 'icon', icon: 'arrow' %}</a>
    {%- endif -%}
  </div>

  <div class="page-width">
    <div class="grid grid--{{ section.settings.columns }}">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="card reveal" style="--i: {{ forloop.index0 }}" data-tilt-card>
            <div class="card__media media media--portrait">
              {{ 'product-apparel-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
              <span class="card__glare" aria-hidden="true"></span>
            </div>
            <div class="card__info">
              <h3 class="card__title">{{ 'sections.featured_collection.placeholder_title' | t }}</h3>
              <div class="price"><span class="price__current">{{ 4500 | money }}</span></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Merch drop",
  "class": "section-merch",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MERCH / DROP 001" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "OFF THE LINE" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 16, "step": 1, "label": "Products to show", "default": 8 },
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    }
  ],
  "presets": [{ "name": "Merch drop" }]
}
{% endschema %}
