<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}
    {% render 'theme-fonts' %}
    {% render 'theme-styles' %}
    {{ 'faktory.css' | asset_url | stylesheet_tag }}
    <script>
      window.Faktory = { settings: { tilt: {{ settings.enable_tilt | json }}, cursor: false, tiltIntensity: {{ settings.tilt_intensity | divided_by: 100.0 | json }} }, strings: {}, routes: {} };
    </script>
    <script type="importmap">
      {
        "imports": {
          "three": "{{ 'three.module.min.js' | asset_url }}",
          "three/addons/gltf-loader": "{{ 'three-gltf-loader.js' | asset_url }}",
          "three/addons/buffer-geometry-utils": "{{ 'three-buffer-geometry-utils.js' | asset_url }}"
        }
      }
    </script>
    <script src="{{ 'faktory.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'faktory-3d.js' | asset_url }}" type="module"></script>
    {{ content_for_header }}
  </head>
  <body class="template-password{% if settings.enable_grain %} has-grain{% endif %}{% if settings.chrome_style == 'holo' %} chrome-holo{% endif %}">
    <main id="MainContent" class="main" role="main">
      {{ content_for_layout }}
    </main>
    {%- if settings.enable_tilt -%}
      <button type="button" class="tilt-permission chrome-btn" data-tilt-permission hidden>
        <span>{{ 'general.enable_tilt' | t }}</span>
      </button>
    {%- endif -%}
  </body>
</html>
