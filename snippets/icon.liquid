{%- case icon -%}
  {%- when 'close' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="2" fill="none"/></svg>
  {%- when 'menu' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 7h20M2 17h20" stroke="currentColor" stroke-width="2" fill="none"/></svg>
  {%- when 'cart' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18l-2 14H5L3 6zm5 0a4 4 0 018 0" stroke="currentColor" stroke-width="2" fill="none"/></svg>
  {%- when 'search' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="2" fill="none"/><path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="2"/></svg>
  {%- when 'account' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2" fill="none"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" stroke="currentColor" stroke-width="2" fill="none"/></svg>
  {%- when 'arrow' -%}
    <svg class="icon icon--arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12h17M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none"/></svg>
  {%- when 'play' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4l13 8-13 8z" fill="currentColor"/></svg>
  {%- when 'plus' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4v16M4 12h16" stroke="currentColor" stroke-width="2"/></svg>
  {%- when 'minus' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h16" stroke="currentColor" stroke-width="2"/></svg>
  {%- when '3d' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2l9 5v10l-9 5-9-5V7z M12 12l9-5 M12 12v10 M12 12L3 7" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>
{%- endcase -%}
