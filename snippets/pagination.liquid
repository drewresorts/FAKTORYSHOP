<nav class="pagination mono" aria-label="{{ 'general.pagination' | t }}">
  {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="ghost-btn ghost-btn--sm"><span>&larr; {{ 'general.prev' | t }}</span></a>{%- endif -%}
  <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
  {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="ghost-btn ghost-btn--sm"><span>{{ 'general.next' | t }} &rarr;</span></a>{%- endif -%}
</nav>
